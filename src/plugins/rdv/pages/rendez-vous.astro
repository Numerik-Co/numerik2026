---
/**
 * Page publique de prise de RDV, à l'adresse `adresse:` de
 * `src/content/rdv.yaml` (route ajoutée par `src/integrations/plugins.ts`).
 * Textes et ouverture : `rdv.yaml` (`rdvConfig`).
 */
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/sections/PageHeader.astro';
import FormGate from '../../../components/forms/FormGate.astro';
import RdvForm from '../formulaire/RdvForm.vue';
import { association } from '../../../lib/association';
import { rdvConfig, rdvFormProps, remplir } from '../lib/config';
import { rdvToggle } from '../index';

const { textes, creneaux } = rdvConfig;
const description = remplir(textes.description, { duree: creneaux.duree });
---

<Layout
	title={`${textes.nom} · ${association.name}`}
	description={description}
	breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: textes.nom }]}
>
	<PageHeader slot="page-header" title={textes.titre} description={description} />

	<FormGate toggle={rdvToggle()}>
		<RdvForm client:load {...rdvFormProps()} />
	</FormGate>
</Layout>
