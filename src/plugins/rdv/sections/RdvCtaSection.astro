---
/**
 * Encart de prise de RDV (module d'accueil et bloc de page `rdv`),
 * dans l'esprit de `CtaSection.astro` mais en carte claire, pour ne pas
 * doubler le bandeau dégradé « Envie de nous rejoindre ? ».
 * Jours, horaires et lieux sont déduits des `permanences` ; textes et logo
 * par défaut : `encart:` de `src/content/rdv.yaml` (une prop vide les garde).
 */
import Button from '../../../components/ui/Button.astro';
import { permanences } from '../lib/permanences';
import { rdvConfig, remplir } from '../lib/config';
import { RDV_HREF, rdvToggle } from '../index';

interface Props {
	eyebrow?: string;
	title?: string;
	description?: string;
	buttonLabel?: string;
	buttonHref?: string;
}

const { encart, creneaux } = rdvConfig;
const p = Astro.props;
const eyebrow = p.eyebrow || encart.surtitre;
const title = p.title || encart.titre;
const description = p.description || encart.texte;
const buttonLabel = p.buttonLabel || encart.bouton;
const buttonHref = p.buttonHref || RDV_HREF;
const mention = remplir(encart.mention, { duree: creneaux.duree });

// Logo facultatif de l'association (`encart.logo`, fichier de src/content/images/).
type ImageModule = { default: ImageMetadata };
const images = import.meta.glob<ImageModule>('../../../content/images/*.{svg,png,jpg,jpeg,webp}', { eager: true });
const logoEntry = encart.logo ? Object.entries(images).find(([chemin]) => chemin.endsWith(`/${encart.logo}`)) : undefined;
if (encart.logo && !logoEntry) {
	throw new Error(`src/content/rdv.yaml : logo de l'encart « ${encart.logo} » introuvable dans src/content/images/.`);
}
const logo = logoEntry?.[1].default;

// Prise de RDV en ligne fermée : l'encart reste utile (permanences), le
// bouton mène à la page qui affiche le message de fermeture.
const ouvert = rdvToggle().enabled;

/** « 09h00 » -> « 9 h », « 09h30 » -> « 9 h 30 » */
function heure(h: string): string {
	const [hh, mm] = h.split('h');
	return mm && mm !== '00' ? `${Number(hh)} h ${mm}` : `${Number(hh)} h`;
}

const jours = permanences.map((s) => s.day.toLowerCase());
const semaine = ['lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi'];
const libelleJours =
	jours.length === 5 && semaine.every((j) => jours.includes(j)) ? 'Du lundi au vendredi' : jours.join(', ');

const plages = [...new Set(permanences.map((s) => `${heure(s.start)} – ${heure(s.end)}`))];

// Lieu -> jours concernés, dans l'ordre de la semaine.
const lieux = new Map<string, string[]>();
for (const s of permanences) {
	const lieu = s.location ?? '';
	if (!lieu) continue;
	if (!lieux.has(lieu)) lieux.set(lieu, []);
	lieux.get(lieu)!.push(s.day.toLowerCase());
}
const plusieursLieux = lieux.size > 1;
---

{/* Aucune permanence dans src/content/rdv.yaml : encart absent. */}
{permanences.length > 0 && (
	<section class="bg-gray-100 py-16">
		<div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 sm:px-6 md:flex-row md:items-center md:justify-between">
				<div>
					<p class="text-sm font-semibold uppercase tracking-wider text-primary">
						<i class="fa-solid fa-headset mr-2" aria-hidden="true"></i>{eyebrow}
					</p>
					<h2 class="mt-2 text-3xl text-gray-900">{title}</h2>
					<!-- Logo à gauche, texte + permanences à sa droite (empilés sur mobile) -->
					<div class="mt-6 flex flex-col gap-6 sm:flex-row sm:items-center">
						{logo && (
							<img
								src={logo.src}
								width={logo.width}
								height={logo.height}
								alt={encart.logoAlt}
								class="h-24 w-auto shrink-0 self-start sm:self-center"
							/>
						)}
						<div>
							<p class="max-w-xl font-light text-gray-600">{description}</p>

							<ul class="mt-6 space-y-2 text-sm text-gray-700">
								<li class="flex gap-3">
									<i class="fa-regular fa-calendar mt-0.5 w-4 text-center text-primary" aria-hidden="true"></i>
									<span>{libelleJours} · {plages.join(' / ')}</span>
								</li>
								{
									[...lieux].map(([lieu, joursLieu]) => (
										<li class="flex gap-3">
											<i class="fa-solid fa-location-dot mt-0.5 w-4 text-center text-primary" aria-hidden="true" />
											<span>
												{lieu}
												{plusieursLieux && <span class="text-gray-500"> ({joursLieu.join(', ')})</span>}
											</span>
										</li>
									))
								}
							</ul>
						</div>
					</div>
				</div>
				<div class="shrink-0 text-center md:text-right">
					<Button href={buttonHref}>
						<i class={`fa-solid ${ouvert ? 'fa-calendar-plus' : 'fa-circle-info'} mr-2`} aria-hidden="true"></i>
						{ouvert ? buttonLabel : 'Voir les permanences'}
					</Button>
					<p class="mt-3 text-xs text-gray-500">{mention}</p>
				</div>

		</div>
	</section>
)}
