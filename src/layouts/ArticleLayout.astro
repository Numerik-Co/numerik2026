---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import AdminLoader from '../components/admin/AdminLoader.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import Article from '../components/article/Article.astro';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import { association } from '../lib/association';

interface Props {
	title?: string;
	description?: string;
	breadcrumbs?: { label: string; href?: string }[];
	/** Image d'aperçu (Open Graph) utilisée lors d'un partage sur les réseaux sociaux. */
	image?: any;
	/** `og:type` : `article` pour une actualité, `website` sinon. */
	ogType?: 'article' | 'website';
	/** Page réservée (espace connecté) : exclue des moteurs de recherche. */
	noindex?: boolean;
}

const {
	title = association.name,
	description = association.description,
	breadcrumbs,
	image,
	ogType = 'website',
	noindex = false,
} = Astro.props;

// Balises Open Graph : Facebook en tire le titre, le résumé et l'image
// de l'aperçu lors d'un partage (voir `ShareTools.astro`).
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
// Recadrage au ratio paysage recommandé par Facebook (1,91:1, grand
// aperçu dès 600 px de large), sans agrandir une couverture plus petite
// que 1200 px. Une couverture trop petite pour ce recadrage est envoyée
// entière. Les dimensions déclarées doivent être celles du fichier
// réellement produit, sinon Facebook peut publier le lien sans son image.
const OG_RATIO = 1200 / 630;
const og = image
	? await (() => {
			const width = Math.min(1200, image.width, Math.round(image.height * OG_RATIO));
			return width >= 600
				? getImage({ src: image, width, height: Math.round(width / OG_RATIO), fit: 'cover', format: 'jpg' })
				: getImage({ src: image, width: image.width, height: image.height, format: 'jpg' });
		})()
	: undefined;
const ogImage = og ? new URL(og.src, canonicalUrl).href : undefined;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:site_name" content={association.name} />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{og && ogImage && (
			<>
				<meta property="og:image" content={ogImage} />
				<meta property="og:image:type" content="image/jpeg" />
				<meta property="og:image:width" content={String(og.attributes.width)} />
				<meta property="og:image:height" content={String(og.attributes.height)} />
				<meta property="og:image:alt" content={title} />
			</>
		)}
	</head>
	<body class="flex min-h-screen flex-col bg-white">
		<Header />
		<main class="flex-1">
			<slot name="page-header" />
			{breadcrumbs && <Breadcrumb items={breadcrumbs} />}
			<Article>
				<slot name="sidebar" slot="sidebar" />
				<slot />
			</Article>
		</main>
		<Footer />
		<AdminLoader />
	</body>
</html>
