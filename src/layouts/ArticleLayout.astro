---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import AdminLoader from '../components/admin/AdminLoader.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import SeoHead from '../components/layout/SeoHead.astro';
import Article from '../components/article/Article.astro';
import '../styles/global.css';
import { association } from '../lib/association';
import type { JsonLd } from '../lib/seo';
import { favicons } from '../lib/site-images';
import { themeCss } from '../config/site';

interface Props {
	title?: string;
	description?: string;
	breadcrumbs?: { label: string; href?: string }[];
	/** Image d'aperçu (Open Graph) utilisée lors d'un partage sur les réseaux sociaux. */
	image?: any;
	/** `og:type` : `article` pour une actualité, `website` sinon. */
	ogType?: 'article' | 'website';
	/** Page réservée (espace connecté) : exclue des moteurs de recherche. */
	noindex?: boolean;
	/** Données structurées propres à la page (schema.org, ex. actualité). */
	jsonLd?: JsonLd[];
}

const {
	title = association.name,
	description = association.description,
	breadcrumbs,
	image,
	ogType = 'website',
	noindex = false,
	jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{favicons.map((icon) => <link rel="icon" type={icon.type} href={icon.href} />)}
		{/* Couleurs du thème (src/content/reglages.yaml) : remplacent celles de global.css. */}
		<style is:inline set:html={themeCss} />
		<meta name="generator" content={Astro.generator} />
		<SeoHead {title} {description} {image} {ogType} {noindex} {breadcrumbs} {jsonLd} />
	</head>
	<body class="flex min-h-screen flex-col bg-white">
		<Header />
		<main class="flex-1">
			<slot name="page-header" />
			{breadcrumbs && <Breadcrumb items={breadcrumbs} />}
			<Article>
				<slot name="sidebar" slot="sidebar" />
				<slot />
			</Article>
		</main>
		<Footer />
		<AdminLoader />
	</body>
</html>
