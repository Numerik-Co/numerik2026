---
import AnnonceBanner from '../components/layout/AnnonceBanner.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import AdminLoader from '../components/admin/AdminLoader.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import '../styles/global.css';
import { association } from '../lib/association';
import { favicons } from '../lib/site-images';
import { themeCss } from '../config/site';

interface Props {
	title?: string;
	description?: string;
	breadcrumbs?: { label: string; href?: string }[];
	/** Page réservée (espace connecté) : exclue des moteurs de recherche. */
	noindex?: boolean;
}

const {
	title = association.name,
	description = association.description,
	breadcrumbs,
	noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{favicons.map((icon) => <link rel="icon" type={icon.type} href={icon.href} />)}
		{/* Couleurs du thème (src/content/reglages.yaml) : remplacent celles de global.css. */}
		<style is:inline set:html={themeCss} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		{noindex && <meta name="robots" content="noindex, nofollow" />}
	</head>
	<body class="flex min-h-screen flex-col bg-white">
		<AnnonceBanner />
		<Header />
		<main class="flex-1">
			<slot name="page-header" />
			{breadcrumbs && <Breadcrumb items={breadcrumbs} />}
			<slot />
		</main>
		<Footer />
		<AdminLoader />
	</body>
</html>
