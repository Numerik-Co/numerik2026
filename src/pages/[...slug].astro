---
/**
 * Route attrape-tout : rend n'importe quelle page **publique** rangée dans
 * `src/content/pages/<...>/index.{md,mdx}` (collection `pages`). L'éditeur
 * n'a qu'à créer le fichier markdown, aucune page `.astro` à écrire.
 *
 * Prérendue : une page HTML statique par page, produite par `npm run build`.
 * Les pages réservées (`src/content/pages/espace-benevoles/`) sont servies à
 * la demande par `src/pages/espace-benevoles/[...slug].astro`.
 */
import ContentPageView from '../components/article/ContentPageView.astro';
import { getContentPages } from '../lib/content-pages';

export async function getStaticPaths() {
	return (await getContentPages())
		.filter((page) => page.access === null)
		.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
---

<ContentPageView page={page} />
