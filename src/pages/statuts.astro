---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import { getPageBySlug } from '../lib/pages';
import { association } from '../lib/association';

const page = getPageBySlug('statuts');
const { Content } = page;
---

<ArticleLayout
	title={`${page.title} · ${association.name}`}
	description={`Statuts de l'association ${association.name}.`}
	breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: page.title }]}
>
	<PageHeader slot="page-header" title={`${page.title} de l'association`} />

	<div class="markdown-content font-light text-gray-700">
		<Content />
	</div>
</ArticleLayout>
