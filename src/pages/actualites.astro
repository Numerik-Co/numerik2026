---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getAllNews } from '../lib/news';
import { association } from '../lib/association';

const articles = getAllNews();
const tags = [...new Set(articles.map((article) => article.tag).filter(Boolean))];
---

<Layout
	title={`Actualités · ${association.name}`}
	description={`Les dernières actualités de l'association ${association.name} : ateliers, partenariats et temps forts.`}
	breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: 'Actualités' }]}
>
	<PageHeader
		slot="page-header"
		title="Actualités"
		description="Les dernières nouvelles de l'association et de ses actions sur le terrain."
	/>

	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<div class="flex flex-wrap items-center justify-between gap-4 pb-8">
			<div id="tag-filters" class="flex flex-wrap gap-2">
				<button type="button" class="filter-btn is-active" data-tag="all">Toutes</button>
				{tags.map((tag) => (
					<button type="button" class="filter-btn" data-tag={tag}>{tag}</button>
				))}
			</div>

			<a
				href="/rss.xml"
				target="_blank"
				rel="noopener"
				class="inline-flex items-center gap-2 rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-gray-600 transition-colors hover:border-accent hover:text-accent"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
					<path d="M4 4a16 16 0 0 1 16 16h-3A13 13 0 0 0 4 7V4Zm0 6a10 10 0 0 1 10 10h-3a7 7 0 0 0-7-7v-3Zm2 7a3 3 0 1 1 0 6 3 3 0 0 1 0-6Z" />
				</svg>
				Flux RSS
			</a>
		</div>

		<div id="article-grid" class="grid gap-6 md:grid-cols-3">
			{articles.map((article, index) => (
				<div data-article-tag={article.tag ?? ''}>
					<ArticleCard article={article} loading={index < 3 ? 'eager' : 'lazy'} />
				</div>
			))}
		</div>
	</section>
</Layout>

<script>
	const buttons = document.querySelectorAll('#tag-filters .filter-btn');
	const cards = document.querySelectorAll('#article-grid [data-article-tag]');

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			buttons.forEach((b) => b.classList.remove('is-active'));
			button.classList.add('is-active');

			const tag = button.getAttribute('data-tag');
			cards.forEach((card) => {
				const matches = tag === 'all' || card.getAttribute('data-article-tag') === tag;
				card.classList.toggle('hidden', !matches);
			});
		});
	});
</script>

<style>
	.filter-btn {
		border-radius: 9999px;
		padding: 0.5rem 1rem;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--color-gray-600, #4b5563);
		background: var(--color-gray-100, #f3f4f6);
		transition:
			background-color 0.15s,
			color 0.15s;
	}

	.filter-btn:hover:not(.is-active) {
		background: color-mix(in oklab, var(--color-primary) 12%, white);
		color: var(--color-primary);
	}

	.filter-btn.is-active {
		background: var(--color-primary);
		color: white;
	}
</style>
