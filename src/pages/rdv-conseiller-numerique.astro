---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import FormGate from '../components/forms/FormGate.astro';
import RdvForm from '../components/rdv/RdvForm.vue';
import { association } from '../lib/association';
---

<Layout
	title={`RDV Conseiller·ère Numérique · ${association.name}`}
	description="Prenez rendez-vous avec le·la conseiller·ère numérique de l'association pour un accompagnement individuel."
	breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: 'RDV Conseiller·ère Numérique' }]}
>
	<PageHeader
		slot="page-header"
		title="RDV avec le·la Conseiller·ère Numérique"
		description="Réservez un créneau de 30 minutes pour un accompagnement individuel — navigation, démarches administratives, e-mail, sécurité numérique…"
	/>

	<FormGate form="rdvConseillerNumerique">
		<RdvForm client:load />
	</FormGate>
</Layout>
