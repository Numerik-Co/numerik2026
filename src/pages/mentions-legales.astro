---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { getPageBySlug } from '../lib/pages';
import { association } from '../lib/association';

const page = getPageBySlug('mentions-legales');
const { Content } = page;
---

<ArticleLayout
	title={`${page.title} · ${association.name}`}
	description={`Mentions légales du site de ${association.name}.`}
	breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: page.title }]}
>
	<PageHeader slot="page-header" title={page.title} />

	{page.headings.length > 1 && <TableOfContents slot="sidebar" headings={page.headings} />}

	<div class="markdown-content font-light text-gray-700">
		<Content />
	</div>
</ArticleLayout>
