---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import PartenairesSection from '../components/sections/PartenairesSection.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import { association } from '../lib/association';
import { isFormOpen } from '../lib/forms';

const adhesionEnLigneOuverte = isFormOpen('adhesion');

const memberships = [
	{
		title: 'Membre individuel',
		description:
			"Participez aux ateliers, aux événements et à la vie de l'association en tant qu'adhérent·e.",
	},
	{
		title: 'Membre bénévole',
		description:
			'Donnez de votre temps pour animer des ateliers ou accompagner nos actions sur le terrain.',
	},
	{
		title: 'Membre partenaire',
		description:
			`Votre structure souhaite soutenir ou collaborer avec ${association.name} sur un projet commun.`,
	},
];

const cotisations = [
	{ label: 'Individuelle', price: '30 €' },
	{ label: 'Couple', price: '50 €' },
	{ label: 'Chômeur·euse · étudiant·e', price: '20 €' },
	{ label: 'Jeune de moins de 16 ans', price: 'Gratuit' },
	{ label: 'Structure', price: '110€' },
];

const activites = [
	{ label: 'Cours à l’année', price: '30 € par trimestre' },
	{ label: 'Perfectionnement', price: '45 €' },
	{ label: 'FabLab', price: '30 € par trimestre' },
	{ label: 'Juniors', price: 'Gratuit' },
];
---

<Layout
	title={`Adhérer · ${association.name}`}
	description={`Rejoignez ${association.name} en tant qu'adhérent·e, bénévole ou partenaire.`}
	breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: 'Adhérer' }]}
>
	<PageHeader
		slot="page-header"
		title={`Adhérer à ${association.name}`}
		description="Bénévoles, adhérent·e·s ou partenaires : chacun·e a sa place dans l'association."
	/>

	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<div class="grid gap-6 md:grid-cols-3">
			{memberships.map((membership) => (
				<Card title={membership.title}>{membership.description}</Card>
			))}
		</div>

		<div class="mt-12 text-center">
			{adhesionEnLigneOuverte ? (
				<>
					<Button href="/adherer/formulaire" variant="primary">Adhérer en ligne</Button>
					<p class="mt-3 text-sm font-light text-gray-500">
						Nouvelle adhésion ou renouvellement, en quelques minutes.
					</p>
				</>
			) : (
				<p class="mx-auto max-w-xl text-sm font-light text-gray-500">
					L'adhésion en ligne est momentanément fermée. Retrouvez ci-dessous comment
					adhérer autrement, ou <a href="/contact" class="text-primary hover:text-secondary">contactez-nous</a>.
				</p>
			)}
		</div>
	</section>

	<section class="bg-gray-50 py-16">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<div class="max-w-2xl">
				<h2 class="text-3xl text-gray-900">Tarifs 2026-2027</h2>
				<p class="mt-4 font-light text-gray-600">
					L'adhésion est valable de début septembre à fin juin. La cotisation n'est pas
					remboursable. <br>
					Une cotisation au sein d'une association ou d'un club sportif est une contribution des membres permettant d'assurer la pérénité de la structure et des actions qu'elle mets en place.
					Ce geste si banal est une manière de soutenir le projet de l'association et ce qu'elle défend.
				</p>
			</div>

			<div class="mt-10 grid gap-6 md:grid-cols-2">
				<div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
					<h3 class="text-lg text-gray-900">Cotisations</h3>
					<ul class="mt-4 divide-y divide-gray-100 text-sm">
						{cotisations.map((item) => (
							<li class="flex items-center justify-between py-2 font-light text-gray-600">
								<span>{item.label}</span>
								<span class="font-heading font-semibold text-gray-900">{item.price}</span>
							</li>
						))}
					</ul>
				</div>

				<div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
					<h3 class="text-lg text-gray-900">Activités</h3>
					<ul class="mt-4 divide-y divide-gray-100 text-sm">
						{activites.map((item) => (
							<li class="flex items-center justify-between py-2 font-light text-gray-600">
								<span>{item.label}</span>
								<span class="font-heading font-semibold text-gray-900">{item.price}</span>
							</li>
						))}
					</ul>
					<p class="font-light text-gray-900">* : Les tarifs indiqués sont étudiés chaque année et validés lors de l'assemblée générale.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<div class="grid gap-10 md:grid-cols-2">
			<div>
				<h2 class="text-3xl text-gray-900">Ce que l'adhésion vous apporte</h2>
				<p class="mt-4 font-light text-gray-600">
					Pendant les périodes d'ouverture de la salle, l'adhésion donne droit :
				</p>
				<ul class="mt-4 space-y-2 font-light text-gray-600">
					<li class="flex gap-2">
						<i class="fa-solid fa-check mt-1 text-primary" aria-hidden="true"></i>
						<span>à l'utilisation des équipements et des logiciels du club ;</span>
					</li>
					<li class="flex gap-2">
						<i class="fa-solid fa-check mt-1 text-primary" aria-hidden="true"></i>
						<span>aux conseils et à l'accompagnement de nos animateur·rice·s bénévoles et de notre service civique.</span>
					</li>
				</ul>
				<p class="mt-6 font-light text-gray-600">
					Auprès de notre partenaire principal <strong>Informatique40</strong>, l'adhésion ouvre
					aussi droit à <strong>5 %</strong> de remise sur le matériel neuf et <strong>10 %</strong>
					sur les consommables.
				</p>
			</div>

			<div>
				<h2 class="text-3xl text-gray-900">Comment adhérer ?</h2>
				<p class="mt-4 font-light text-gray-600">
					Vous pouvez récupérer la fiche d'adhésion :
				</p>
				<ul class="mt-4 space-y-2 font-light text-gray-600">
					<li class="flex gap-2">
						<i class="fa-solid fa-location-dot mt-1 text-primary" aria-hidden="true"></i>
						<span>lors de votre venue dans notre salle, pour découvrir nos activités ;</span>
					</li>
					<li class="flex gap-2">
						<i class="fa-solid fa-handshake mt-1 text-primary" aria-hidden="true"></i>
						<span>auprès de nos partenaires : Mairie de Saint-Pierre-du-Mont, Informatique40 ;</span>
					</li>
					<li class="flex gap-2">
						<i class="fa-solid fa-envelope mt-1 text-primary" aria-hidden="true"></i>
						<span>en <a href="/contact" class="text-primary hover:text-secondary">nous contactant</a> directement.</span>
					</li>
				</ul>
				<div class="mt-6">
					<Button href="/contact" variant="primary">Nous contacter</Button>
				</div>
			</div>
		</div>
	</section>

	<PartenairesSection class="border-t border-gray-100" />
</Layout>
