---
import FigureImage from '../../../components/FigureImage.astro';
import PrevNextNav from '../../../components/PrevNextNav.astro';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import ReadingProgress from '../../../components/ReadingProgress.astro';
import PageHeader from '../../../components/sections/PageHeader.astro';
import { getActivitiesByCategory } from '../../../lib/activites';
import { categories, getCategory } from '../../../lib/categories';
import { association } from '../../../lib/association';

export async function getStaticPaths() {
	return categories.flatMap((cat) => {
		const activities = getActivitiesByCategory(cat.slug);

		return activities.map((activity, index) => ({
			params: { category: cat.slug, slug: activity.slug },
			props: {
				activity,
				prev: activities[index - 1] ?? null,
				next: activities[index + 1] ?? null,
			},
		}));
	});
}

const { activity, prev, next } = Astro.props;
const { Content } = activity;
const category = getCategory(activity.category);
---

<ArticleLayout
	title={`${activity.title} · ${association.name}`}
	description={activity.excerpt}
	breadcrumbs={[
		{ label: 'Accueil', href: '/' },
		{ label: 'Activités', href: '/activites' },
		{ label: category?.label ?? 'Activités', href: `/activites/${activity.category}` },
		{ label: activity.title },
	]}
>
	<PageHeader slot="page-header" title={activity.title} description={activity.excerpt} />

	{activity.headings.length > 1 && (
		<Fragment slot="sidebar">
			<ReadingProgress minutes={activity.readingTime} />
			<TableOfContents headings={activity.headings} />
		</Fragment>
	)}

	{activity.image && (
		<FigureImage
			image={activity.image}
			alt={activity.title}
			caption={activity.imageCredit}
			loading="eager"
			class="mb-8"
		/>
	)}

	<div class="markdown-content mt-6 font-light text-gray-700">
		<Content />
	</div>

	<div class="mt-12 border-t border-gray-100 pt-8">
		<PrevNextNav prev={prev} next={next} />

		<div class="mt-8 text-center">
			<a
				href={`/activites/${activity.category}`}
				class="inline-flex items-center gap-2 font-heading text-sm font-semibold text-primary transition-colors hover:text-secondary"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
				</svg>
				Retour à {category?.label ?? 'la catégorie'}
			</a>
		</div>
	</div>
</ArticleLayout>
