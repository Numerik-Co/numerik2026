---
import FigureImage from '../../../components/article/FigureImage.astro';
import PrevNextNav from '../../../components/article/PrevNextNav.astro';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import TableOfContents from '../../../components/article/TableOfContents.astro';
import ReadingProgress from '../../../components/article/ReadingProgress.astro';
import PageHeader from '../../../components/sections/PageHeader.astro';
import { getActivitiesByCategory } from '../../../lib/activites';
import { categories, getCategory } from '../../../lib/categories';
import { association } from '../../../lib/association';
import { isFormOpen } from '../../../lib/forms';

export async function getStaticPaths() {
	return categories.flatMap((cat) => {
		const activities = getActivitiesByCategory(cat.slug);

		return activities.map((activity, index) => ({
			params: { category: cat.slug, slug: activity.slug },
			props: {
				activity,
				prev: activities[index - 1] ?? null,
				next: activities[index + 1] ?? null,
			},
		}));
	});
}

const { activity, prev, next } = Astro.props;
const { Content } = activity;
const category = getCategory(activity.category);
const inscriptionHref = isFormOpen('adhesion') ? '/adherer/formulaire' : '/adherer';
---

<ArticleLayout
	title={`${activity.title} · ${association.name}`}
	description={activity.excerpt}
	breadcrumbs={[
		{ label: 'Accueil', href: '/' },
		{ label: 'Activités', href: '/activites' },
		{ label: category?.label ?? 'Activités', href: `/activites/${activity.category}` },
		{ label: activity.title },
	]}
>
	<PageHeader slot="page-header" title={activity.title} description={activity.excerpt} />

	<Fragment slot="sidebar">
		{activity.headings.length > 1 && (
			<>
				<ReadingProgress minutes={activity.readingTime} />
				<TableOfContents headings={activity.headings} />
			</>
		)}
		<a
			href={inscriptionHref}
			class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-primary px-5 py-2.5 font-heading text-sm font-semibold text-white transition-colors hover:opacity-90"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v6m3-3h-6m-2.25-3.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM4 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 10.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
			</svg>
			S'inscrire
		</a>
	</Fragment>

	{activity.image && (
		<FigureImage
			image={activity.image}
			alt={activity.title}
			caption={activity.imageCredit}
			loading="eager"
			class="mb-8"
		/>
	)}

	<div class="markdown-content mt-6 font-light text-gray-700">
		<Content />
	</div>

	<div class="mt-12 border-t border-gray-100 pt-8">
		<PrevNextNav prev={prev} next={next} />

		<div class="mt-8 text-center">
			<a
				href={`/activites/${activity.category}`}
				class="inline-flex items-center gap-2 font-heading text-sm font-semibold text-primary transition-colors hover:text-secondary"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
				</svg>
				Retour à {category?.label ?? 'la catégorie'}
			</a>
		</div>
	</div>
</ArticleLayout>
