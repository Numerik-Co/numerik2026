---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import ActivityCard from '../../components/cards/ActivityCard.astro';
import { categories } from '../../lib/categories';
import { getActivitiesByCategory } from '../../lib/activites';
import { association } from '../../lib/association';

export async function getStaticPaths() {
	return categories.map((category) => ({
		params: { category: category.slug },
		props: { category },
	}));
}

const { category } = Astro.props;
const activities = getActivitiesByCategory(category.slug);
---

<Layout
	title={`${category.label} · ${association.name}`}
	description={`Découvrez les activités de la catégorie ${category.label} proposées par ${association.name}.`}
	breadcrumbs={[
		{ label: 'Accueil', href: '/' },
		{ label: 'Activités', href: '/activites' },
		{ label: category.label },
	]}
>
	<PageHeader slot="page-header" title={category.label} description={category.description} />

	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		{activities.length > 0 ? (
			<div class="grid gap-6 md:grid-cols-3">
				{activities.map((activity, index) => (
					<ActivityCard activity={activity} loading={index === 0 ? 'eager' : 'lazy'} />
				))}
			</div>
		) : (
			<div class="mx-auto max-w-md text-center">
				<span class="flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 text-2xl text-primary mx-auto">
					<i class={`fa-solid ${category.icon}`} aria-hidden="true"></i>
				</span>
				<p class="mt-4 font-light text-gray-600">
					De nouvelles activités {category.label} arrivent bientôt. N'hésitez pas à
					<a href="/contact" class="text-primary hover:text-secondary"> nous contacter</a>
					pour en savoir plus.
				</p>
			</div>
		)}
	</section>
</Layout>
