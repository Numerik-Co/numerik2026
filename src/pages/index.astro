---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import ActivitesSection from '../components/sections/ActivitesSection.astro';
import ActualitesSection from '../components/sections/ActualitesSection.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import RdvCtaSection from '../components/sections/RdvCtaSection.astro';
import heroImage from '../styles/img/hero-mediation-numerique.jpg';
import { getSitePage, inactiveSiteHrefs } from '../lib/site-pages-content';

// Textes réglés depuis le module « Pages » (bibliothèque src/lib/site-pages.ts).
const { t } = await getSitePage('accueil');
// Liens vers une page du site désactivée : masqués ('' et non undefined, qui
// rendrait au composant son lien par défaut).
const off = await inactiveSiteHrefs();
const link = (href: string) => (off.has(href) ? '' : href);
---

<Layout>
	<Hero
		title={t['hero-titre']}
		highlight={t['hero-mot']}
		description={t['hero-accroche']}
		primaryLabel={t['hero-bouton-1']}
		primaryHref={link('/activites')}
		secondaryLabel={t['hero-bouton-2']}
		secondaryHref="/adherer"
		backgroundImage={heroImage}
		overlay="black"
	/>
	<ActualitesSection
		eyebrow={t['actus-surtitre']}
		title={t['actus-titre']}
		ctaLabel={t['actus-lien']}
		ctaHref={link('/actualites')}
		limit={3}
	/>
	<RdvCtaSection />
	<ActivitesSection
		title={t['activites-titre']}
		ctaLabel={t['activites-lien']}
		ctaHref={link('/activites')}
	/>
	<CtaSection
		title={t['rejoindre-titre']}
		description={t['rejoindre-texte']}
		buttonLabel={t['rejoindre-bouton']}
		buttonHref="/adherer"
	/>
</Layout>
