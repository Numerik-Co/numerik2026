---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import { getPageBySlug } from '../../lib/pages';
import { association } from '../../lib/association';

const page = getPageBySlug('conseiller-numerique');
const { Content } = page;
---

<ArticleLayout
	title={`${page.title} · ${association.name}`}
	description={`L'accompagnement numérique assuré par le conseiller numérique de ${association.name}.`}
	breadcrumbs={[
		{ label: 'Accueil', href: '/' },
		{ label: 'Association' },
		{ label: page.title },
	]}
>
	<PageHeader slot="page-header" title={page.title} description={page.description} />

	<div class="markdown-content font-light text-gray-700">
		<Content />
	</div>
</ArticleLayout>
