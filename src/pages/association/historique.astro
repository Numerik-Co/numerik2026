---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { association } from '../../lib/association';
---

<Layout
	title={`Historique · ${association.name}`}
	description={`Les grandes étapes de l'histoire de ${association.name}.`}
	breadcrumbs={[
		{ label: 'Accueil', href: '/' },
		{ label: 'Association', href: '/association' },
		{ label: 'Historique' },
	]}
>
	<PageHeader
		slot="page-header"
		title="Historique"
		description="Les grandes étapes de l'histoire de l'association."
	/>

	<ArticleLayout>
		<div class="markdown-content font-light text-gray-700">
			<p>Contenu en cours de rédaction.</p>
		</div>

		<div class="mt-12 border-t border-gray-100 pt-8 text-center">
			<a
				href="/association"
				class="inline-flex items-center gap-2 font-heading text-sm font-semibold text-primary transition-colors hover:text-secondary"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
				</svg>
				Retour à l'association
			</a>
		</div>
	</ArticleLayout>
</Layout>
