---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import { association } from '../../lib/association';

const pages = [
	{
		href: '/association/historique',
		icon: 'fa-landmark',
		title: 'Historique',
		description: "Les grandes étapes de l'histoire de l'association.",
	},
	{
		href: '/association/ethique-du-logiciel-libre',
		icon: 'fa-code-branch',
		title: 'Éthique du logiciel libre',
		description: 'Les valeurs qui guident nos choix technologiques.',
	},
	{
		href: '/association/conseiller-numerique',
		icon: 'fa-user-check',
		title: 'Conseiller numérique',
		description: "L'accompagnement numérique assuré par notre conseillère numérique.",
	},
];
---

<Layout
	title={`Association · ${association.name}`}
	description={`Découvrez ${association.name} : son histoire, ses valeurs et son équipe.`}
	breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: 'Association' }]}
>
	<PageHeader
		slot="page-header"
		title="Notre association"
		description="Son histoire, ses valeurs et son équipe."
	/>

	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<div class="grid gap-6 sm:grid-cols-3">
			{pages.map((page) => (
				<a
					href={page.href}
					class="flex flex-col items-center gap-4 rounded-2xl border border-gray-100 bg-white p-8 text-center shadow-sm transition-shadow hover:shadow-md"
				>
					<span class="flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 text-2xl text-primary">
						<i class={`fa-solid ${page.icon}`} aria-hidden="true"></i>
					</span>
					<span class="font-heading text-sm font-semibold uppercase tracking-wide text-gray-900">
						{page.title}
					</span>
					<span class="font-light text-sm text-gray-600">{page.description}</span>
				</a>
			))}
		</div>
	</section>
</Layout>
