---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import ActivitesSection from '../components/sections/ActivitesSection.astro';
import WeeklyAgenda from '../components/sections/WeeklyAgenda.astro';
import { association } from '../lib/association';
import { conseillerNumerique } from '../lib/agenda';
import { fetchPlanningAgenda } from '../lib/adhesion/planning';

import { getSitePage } from '../lib/site-pages-content';

export const prerender = false;

// Page du site désactivable et textes réglés depuis le module « Pages ».
const page = await getSitePage('activites');
// Désactivée : la page 404 du site (le HTML prérendu est retiré par src/integrations/site-pages.ts).
if (!page.active) return new Response(null, { status: 404 });
const { t } = page;

// Grist injoignable : pas de planning figé (il deviendrait vite faux), les
// seules permanences du Conseiller Numérique et un avertissement.
let sessions = conseillerNumerique;
let notice: string | undefined;
try {
	sessions = [...conseillerNumerique, ...(await fetchPlanningAgenda())];
} catch (err) {
	console.error('[activites] Grist injoignable pour le planning : permanences seules.', err);
	notice =
		'Le planning des activités est momentanément indisponible. ' +
		'Contactez-nous pour connaître les horaires des séances.';
}
---

<Layout
	title={`${t.titre} · ${association.name}`}
	description={t.description}
	breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: page.label }]}
>
	<PageHeader
		slot="page-header"
		title={t.titre}
		description={t.accroche}
	/>
	<ActivitesSection showHeading={false} />

	<WeeklyAgenda sessions={sessions} notice={notice} class="border-t border-gray-100" />

	<section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
		<h2 class="text-2xl text-gray-900">{t['bas-titre']}</h2>
		<p class="mt-4 font-light text-gray-600">{t['bas-texte']}</p>
	</section>
</Layout>
