---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import ActivitesSection from '../components/sections/ActivitesSection.astro';
import WeeklyAgenda from '../components/sections/WeeklyAgenda.astro';
import { association } from '../lib/association';
import { conseillerNumerique, weeklyAgenda } from '../lib/agenda';
import { fetchPlanningAgenda } from '../lib/adhesion/planning';

export const prerender = false;

let sessions = weeklyAgenda;
try {
	sessions = [...conseillerNumerique, ...(await fetchPlanningAgenda())];
} catch (err) {
	console.error('[activites] Grist injoignable pour le planning, repli sur le planning par défaut.', err);
}
---

<Layout
	title={`Activités · ${association.name}`}
	description={`Découvrez les parcours, ateliers et actions de médiation numérique proposés par ${association.name}.`}
	breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: 'Activités' }]}
>
	<PageHeader
		slot="page-header"
		title="Activités"
		description="Des parcours, des ateliers et des temps de médiation numérique pour tous les niveaux."
	/>
	<ActivitesSection showHeading={false} />

	<WeeklyAgenda sessions={sessions} class="border-t border-gray-100" />

	<section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
		<h2 class="text-2xl text-gray-900">Une activité à envisager avec nous ?</h2>
		<p class="mt-4 font-light text-gray-600">
			Vous portez un projet associatif, scolaire ou de quartier en lien avec le numérique ?
			Parlons-en.
		</p>
	</section>
</Layout>
