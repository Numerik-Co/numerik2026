---
import FigureImage from '../../components/FigureImage.astro';
import PrevNextNav from '../../components/PrevNextNav.astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import { getAllNews, type NewsArticle } from '../../lib/news';
import { association } from '../../lib/association';

export async function getStaticPaths() {
	function toNavItem(article?: NewsArticle) {
		if (!article) return null;

		return {
			href: article.href,
			title: article.title,
			meta: article.author ? `${article.date} | ${article.author}` : article.date,
		};
	}

	const allNews = getAllNews();

	return allNews.map((article, index) => ({
		params: { slug: article.slug },
		props: {
			article,
			prev: toNavItem(allNews[index - 1]),
			next: toNavItem(allNews[index + 1]),
		},
	}));
}

const { article, prev, next } = Astro.props;
const { Content } = article;
---

<Layout
	title={`${article.title} · ${association.name}`}
	description={article.excerpt}
	breadcrumbs={[
		{ label: 'Accueil', href: '/' },
		{ label: 'Actualités', href: '/actualites' },
		{ label: article.title },
	]}
>
	<PageHeader
		slot="page-header"
		title={article.title}
		description={article.author ? `${article.date} · ${article.author}` : article.date}
	/>

	<ArticleLayout>
		{article.headings.length > 1 && (
			<Fragment slot="sidebar">
				<ReadingProgress minutes={article.readingTime} />
				<TableOfContents headings={article.headings} />
			</Fragment>
		)}

		{article.image && (
			<FigureImage
				image={article.image}
				alt={article.title}
				caption={article.imageCredit}
				loading="eager"
				class="mb-8"
			/>
		)}

		{article.tag && (
			<span class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
				{article.tag}
			</span>
		)}

		<div class="markdown-content mt-6 font-light text-gray-700">
			<Content />
		</div>

		<div class="mt-12 border-t border-gray-100 pt-8">
			<PrevNextNav prev={prev} next={next} />

			<div class="mt-8 text-center">
				<a
					href="/actualites"
					class="inline-flex items-center gap-2 font-heading text-sm font-semibold text-primary transition-colors hover:text-secondary"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
					</svg>
					Retour aux actualités
				</a>
			</div>
		</div>
	</ArticleLayout>
</Layout>
