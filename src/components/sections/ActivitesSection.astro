---
import CategoryCard from '../cards/CategoryCard.astro';
import { categories } from '../../lib/categories';

interface Props {
	showHeading?: boolean;
	title?: string;
	ctaLabel?: string;
	ctaHref?: string;
}

const {
	showHeading = true,
	title = 'Activités',
	ctaLabel = 'Accéder à la page',
	ctaHref = '/activites',
} = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
	{showHeading && (
		<div class="flex flex-wrap items-end justify-between gap-4">
			<h2 class="text-3xl text-gray-900">{title}</h2>
			<a
				href={ctaHref}
				class="inline-flex items-center gap-2 font-heading text-sm font-semibold text-primary transition-colors hover:text-secondary"
			>
				{ctaLabel}
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
				</svg>
			</a>
		</div>
	)}
	<div class={`grid gap-6 sm:grid-cols-2 md:grid-cols-4 ${showHeading ? 'mt-10' : ''}`}>
		{categories.map((category) => (
			<CategoryCard category={category} />
		))}
	</div>
</section>
