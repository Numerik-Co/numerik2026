---
import type { FormToggle } from '../../config/site';
import { getFormToggle, type FormName } from '../../lib/forms';

type Props =
	| {
			/** Clé du formulaire dans `site.forms` (défauts `src/config/site.ts`, réglages `src/content/reglages.yaml`). */
			form: FormName;
	  }
	| {
			/** État fourni directement (formulaire d'un plugin, réglé dans son propre fichier). */
			toggle: FormToggle;
	  };

const props = Astro.props;
const toggle = 'toggle' in props ? props.toggle : getFormToggle(props.form);
const hasFallback = Astro.slots.has('fallback');
---

{
	toggle.enabled ? (
		<slot />
	) : (
		<div
			role="status"
			class="mx-auto max-w-3xl rounded-2xl border border-amber-200 bg-amber-50 px-6 py-8 text-center"
		>
			<i class="fa-solid fa-circle-info text-2xl text-amber-500" aria-hidden="true" />
			<p class="mt-3 font-heading text-lg text-amber-900">{toggle.closedTitle}</p>
			<p class="mt-2 font-light text-amber-800">{toggle.closedMessage}</p>
			{hasFallback && (
				<div class="mt-5">
					<slot name="fallback" />
				</div>
			)}
		</div>
	)
}
