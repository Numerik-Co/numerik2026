---
import { Image } from 'astro:assets';

interface Props {
	article: {
		href: string;
		date: string;
		author?: string;
		title: string;
		excerpt: string;
		tag?: string;
		image?: any;
	};
	loading?: 'lazy' | 'eager';
}

const { article, loading = 'lazy' } = Astro.props;
---

<article class="group flex h-116 flex-col overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition duration-300 ease-out hover:border-primary/30 hover:shadow-xl motion-safe:hover:-translate-y-1.5 motion-safe:hover:scale-[1.02] motion-safe:active:scale-[0.99] motion-safe:active:duration-150">
	<a href={article.href} class="block aspect-video overflow-hidden">
		{article.image ? (
			<Image
				src={article.image}
				alt={article.title}
				width={480}
				height={270}
				loading={loading}
				class="h-full w-full object-cover transition-transform duration-500 ease-out motion-safe:group-hover:scale-110"
			/>
		) : (
			<span class="flex h-full w-full items-center justify-center bg-gradient-to-br from-primary/10 to-secondary/10 text-xl transition-transform duration-500 ease-out motion-safe:group-hover:scale-110">
				Images à venir
			</span>
		)}
	</a>
	<div class="flex flex-1 flex-col overflow-hidden p-6">
		<span class="font-heading text-xs uppercase tracking-wide text-secondary">
			{article.date}{article.author && ` · ${article.author}`}
		</span>
		<h3 class="mt-2 line-clamp-2 text-lg leading-snug text-gray-900">
			<a href={article.href} class="hover:text-primary">{article.title}</a>
		</h3>
		<p class="mt-2 line-clamp-4 font-light text-sm text-gray-600">{article.excerpt}</p>
		{article.tag && (
			<div class="mt-auto pt-4">
				<span class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
					{article.tag}
				</span>
			</div>
		)}
	</div>
</article>
