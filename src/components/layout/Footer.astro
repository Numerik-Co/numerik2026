---
import { Image } from 'astro:assets';
import { logo, logoWidth } from '../../lib/site-images';
import { SOCIAL_NETWORKS, association, getFullAddress } from '../../lib/association';
import { getContentPages } from '../../lib/content-pages';
const year = new Date().getFullYear();

/** Pages légales du pied de page : seulement celles qui existent (statuts et règlement : associations). */
const slugs = new Set((await getContentPages()).filter((p) => !p.access).map((p) => p.slug));
const legalLinks = [
	{ href: '/mentions-legales', label: 'Mentions légales', slug: 'mentions-legales' },
	{ href: '/statuts', label: 'Statuts', slug: 'statuts' },
	{ href: '/reglement-interieur', label: 'Règlement intérieur', slug: 'reglement-interieur' },
].filter((l) => slugs.has(l.slug));

const socialLinks = Object.entries(association.social)
	.filter(([, url]) => !!url)
	.map(([key, url]) => {
		const network = SOCIAL_NETWORKS.find((n) => n.key === key);
		return {
			url: url as string,
			icon: network?.icon ?? 'fa-solid fa-link',
			label: network?.label ?? key.charAt(0).toUpperCase() + key.slice(1),
		};
	});
---

<footer class="bg-secondary text-white">
	<div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3">
		<div>
			<p class="font-heading text-lg">
				<Image src={logo} alt={association.name} width={logoWidth(192)} height={192} class="h-16 w-auto" />
			</p>
			<p class="mt-2 text-sm text-white/80">
				{association.description}
			</p>
		</div>

		<div>
			<p class="font-heading text-sm uppercase tracking-wide text-white">Contact</p>
			<ul class="mt-2 space-y-2 text-sm text-white">
				<li class="flex items-center gap-2">
					<i class="fa-solid fa-envelope w-4 text-white" aria-hidden="true"></i>
					<a href={`mailto:${association.email}`} class="hover:text-white">{association.email}</a>
				</li>
				<li class="flex items-center gap-2">
					<i class="fa-solid fa-phone w-4 text-white" aria-hidden="true"></i>
					<a href={`tel:${association.phone.replace(/\s/g, '')}`} class="hover:text-white">{association.phone}</a>
				</li>
				<li class="flex items-center gap-2">
					<i class="fa-solid fa-location-dot w-4 text-white" aria-hidden="true"></i>
					{getFullAddress()}
				</li>
			</ul>
		</div>

		{
			socialLinks.length > 0 && (
				<div>
					<p class="font-heading text-sm uppercase tracking-wide text-white">Suivez-nous</p>
					<div class="mt-2 flex gap-4">
						{socialLinks.map(({ url, icon, label }) => (
							<a href={url} aria-label={label} class="text-lg text-white hover:text-white">
								<i class={icon} aria-hidden="true" />
							</a>
						))}
					</div>
				</div>
			)
		}
	</div>

	<div class="border-t border-white/10 px-4 py-4 text-center text-xs text-white/70">
		<p>&copy; {year} {association.name}. Tous droits réservés. | Propulsé par Astro et développé par OpenPixl</p>
		<p class="mt-2 flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
			{
				legalLinks.map((l) => (
					<>
						<a href={l.href} class="hover:text-white">
							{l.label}
						</a>
						<span aria-hidden="true">·</span>
					</>
				))
			}
			<!-- Ouvre la modale de connexion (src/components/admin/AdminLoader.astro). -->
			<a href="#connexion" data-auth-open class="hover:text-white">
				<i class="fa-solid fa-lock text-[10px]" aria-hidden="true"></i>
				Espace Admin
			</a>
		</p>
	</div>
</footer>
