---
/**
 * Balises de référencement communes aux deux layouts : adresse canonique
 * (sans `/` final), aperçus de partage (Open Graph, `twitter:card`), lien du
 * flux RSS et données structurées (JSON-LD, `src/lib/seo.ts`) :
 * l'association et le site sur l'accueil, le fil d'Ariane s'il y en a un,
 * plus celles de la page (`jsonLd`, ex. actualité).
 *
 * Image d'aperçu : celle de la page, sinon la photo d'accueil, sinon le logo
 * (s'il n'est pas en SVG, format refusé par les réseaux sociaux).
 */
import { getImage } from 'astro:assets';
import { association } from '../../lib/association';
import {
	absoluteUrl,
	breadcrumbJsonLd,
	cleanPath,
	jsonLdScript,
	organizationJsonLd,
	websiteJsonLd,
	type JsonLd,
} from '../../lib/seo';
import { accueilImage, logo } from '../../lib/site-images';

interface Props {
	title: string;
	description: string;
	image?: any;
	ogType?: 'article' | 'website';
	noindex?: boolean;
	breadcrumbs?: { label: string; href?: string }[];
	jsonLd?: JsonLd[];
}

const { title, description, image, ogType = 'website', noindex = false, breadcrumbs, jsonLd = [] } = Astro.props;

const path = cleanPath(Astro.url.pathname);
const canonicalUrl = absoluteUrl(path, Astro.site);

// Recadrage au ratio paysage recommandé par Facebook (1,91:1, grand
// aperçu dès 600 px de large), sans agrandir une image plus petite
// que 1200 px. Une image trop petite pour ce recadrage est envoyée
// entière. Les dimensions déclarées doivent être celles du fichier
// réellement produit, sinon Facebook peut publier le lien sans son image.
const OG_RATIO = 1200 / 630;
const ogSource = image ?? accueilImage ?? (logo.format === 'svg' ? undefined : logo);
const og = ogSource
	? await (() => {
			const width = Math.min(1200, ogSource.width, Math.round(ogSource.height * OG_RATIO));
			return width >= 600
				? getImage({ src: ogSource, width, height: Math.round(width / OG_RATIO), fit: 'cover', format: 'jpg' })
				: getImage({ src: ogSource, width: ogSource.width, height: ogSource.height, format: 'jpg' });
		})()
	: undefined;
const ogImage = og ? new URL(og.src, canonicalUrl).href : undefined;

const structured: JsonLd[] = [
	...(path === '/' ? [organizationJsonLd(Astro.site, new URL(logo.src, canonicalUrl).href), websiteJsonLd(Astro.site)] : []),
	...(breadcrumbs && breadcrumbs.length > 1 ? [breadcrumbJsonLd(breadcrumbs, path, Astro.site)] : []),
	// Actualité : image d'aperçu reprise comme image de l'article.
	...jsonLd.map((data) => (data['@type'] === 'NewsArticle' && ogImage && !data.image ? { ...data, image: [ogImage] } : data)),
];
---

<meta name="description" content={description} />
<title>{title}</title>
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" type="application/rss+xml" title={`Actualités · ${association.name}`} href={absoluteUrl('/rss.xml', Astro.site)} />
<meta property="og:site_name" content={association.name} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{og && ogImage && (
	<>
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content={String(og.attributes.width)} />
		<meta property="og:image:height" content={String(og.attributes.height)} />
		<meta property="og:image:alt" content={title} />
	</>
)}
<meta name="twitter:card" content={og && Number(og.attributes.width) >= 600 ? 'summary_large_image' : 'summary'} />
{structured.map((data) => <script is:inline type="application/ld+json" set:html={jsonLdScript(data)} />)}
