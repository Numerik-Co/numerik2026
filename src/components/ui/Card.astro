---
interface Props {
	title: string;
	class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div class={`rounded-2xl border border-gray-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md ${className}`}>
	<h3 class="text-lg text-gray-900">{title}</h3>
	<div class="mt-2 text-sm font-light text-gray-600">
		<slot />
	</div>
</div>
