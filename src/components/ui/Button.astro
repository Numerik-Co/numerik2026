---
interface Props {
	href?: string;
	variant?: 'primary' | 'secondary' | 'outline';
	/** `grand` : lien d'appel (Hero, encarts) ; défaut = `grand` pour un lien, taille des champs pour un <button>. */
	size?: 'normal' | 'grand';
	class?: string;
}

const { href, variant = 'primary', size = href ? 'grand' : 'normal', class: className = '' } = Astro.props;

// Classes `bouton-*` de src/styles/forms.css (apparence réglée là).
const variants = {
	primary: 'bouton-primaire',
	secondary: 'bg-secondary text-white hover:opacity-90',
	outline: 'bouton-contour border-2',
};

const classes = ['bouton', variants[variant], size === 'grand' && 'bouton-grand', className];

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class:list={classes}>
	<slot />
</Tag>
