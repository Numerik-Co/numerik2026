---
interface Props {
	href?: string;
	variant?: 'primary' | 'secondary' | 'outline';
	class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;

const variants = {
	primary: 'bg-primary text-white hover:opacity-90',
	secondary: 'bg-secondary text-white hover:opacity-90',
	outline: 'border-2 border-primary text-primary hover:bg-primary hover:text-white',
};

const base = 'inline-flex items-center justify-center rounded-full px-6 py-3 font-heading font-semibold text-sm transition-colors';
const classes = `${base} ${variants[variant]} ${className}`;

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class={classes}>
	<slot />
</Tag>
