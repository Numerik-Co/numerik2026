---
/**
 * Rendu d'un bloc de page enrichie (catalogue : `src/lib/blocs.ts`).
 * Ajouter un type de bloc = une entrée dans `BLOC_TYPES` + une branche ici.
 * Les champs `markdown` passent par `renderMarkdownFragment` (HTML nettoyé).
 */
import Button from '../ui/Button.astro';
import RdvCtaSection from '../sections/RdvCtaSection.astro';
import type { Bloc } from '../../lib/blocs';
import { renderMarkdownFragment, typographie } from '../../lib/markdown-fragment';

interface Props {
	bloc: Bloc;
}

const { bloc } = Astro.props;
const field = (name: string) => (typeof bloc[name] === 'string' ? (bloc[name] as string) : '');
/** Texte simple affiché (titres, libellés) : apostrophes typographiques. */
const text = (value: string | undefined) => typographie(value ?? '');

const ENCART_STYLES: Record<string, { box: string; icon: string }> = {
	info: { box: 'border-sky-200 bg-sky-50 text-sky-900', icon: 'fa-circle-info' },
	attention: { box: 'border-amber-200 bg-amber-50 text-amber-900', icon: 'fa-triangle-exclamation' },
	succes: { box: 'border-green-200 bg-green-50 text-green-900', icon: 'fa-circle-check' },
};
const encart = ENCART_STYLES[field('style')] ?? ENCART_STYLES.info;
---

{bloc.type === 'cartes' && (
	<div class:list={['mt-8 grid gap-6 sm:grid-cols-2', field('colonnes') === '3' && 'lg:grid-cols-3']}>
		{(bloc.items ?? []).map((item) => (
			<div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
				{item.icone && (
					<span class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-xl text-primary">
						<i class={`fa-solid fa-${item.icone}`} aria-hidden="true"></i>
					</span>
				)}
				<p class="font-heading text-lg font-semibold text-gray-900">{text(item.titre)}</p>
				<div class="bloc-texte mt-2 text-sm font-light text-gray-600" set:html={renderMarkdownFragment(item.texte ?? '')} />
			</div>
		))}
	</div>
)}

{bloc.type === 'tarif' && (
	<div class="mt-6 flex items-center justify-between gap-4 rounded-2xl border border-gray-100 bg-gray-50 p-6">
		<span class="font-light text-gray-600">{text(field('libelle'))}</span>
		<span class="shrink-0 font-heading text-2xl font-semibold text-gray-900">{text(field('montant'))}</span>
	</div>
)}

{bloc.type === 'bouton' && (
	<div class="mt-6">
		<Button href={field('lien')} variant={(field('style') || 'primary') as 'primary' | 'secondary' | 'outline'}>{text(field('texte'))}</Button>
	</div>
)}

{bloc.type === 'encart' && (
	<div class:list={['mt-6 rounded-2xl border p-5', encart.box]} role="note">
		{field('titre') && (
			<p class="font-heading font-semibold">
				<i class={`fa-solid ${encart.icon} mr-1.5`} aria-hidden="true"></i>{text(field('titre'))}
			</p>
		)}
		<div class:list={['bloc-texte text-sm', field('titre') && 'mt-1']} set:html={renderMarkdownFragment(field('texte'))} />
	</div>
)}

{bloc.type === 'rdv-conseiller' && (
	<div class="mt-8">
		<RdvCtaSection title={field('titre') || undefined} description={field('texte') || undefined} />
	</div>
)}

<style>
	/* Texte Markdown d'un bloc : listes et paragraphes compacts. */
	.bloc-texte :global(p + p),
	.bloc-texte :global(p + ul),
	.bloc-texte :global(ul + p) {
		margin-top: 0.75rem;
	}
	.bloc-texte :global(ul) {
		margin-top: 0.75rem;
		list-style: disc;
		padding-left: 1.25rem;
	}
	.bloc-texte :global(li + li) {
		margin-top: 0.25rem;
	}
	.bloc-texte :global(a) {
		text-decoration: underline;
	}
</style>
