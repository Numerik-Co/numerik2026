# Instance Grist recevant les adhésions (routes src/pages/api/adhesion/*).
# Copier ce fichier en `.env` (ignoré par git) et renseigner les vraies valeurs, uniquement sur le serveur.
GRIST_BASE_URL=https://grist.exemple.org
GRIST_DOC_ID=
GRIST_API_KEY=

# Noms techniques des tables du document Grist.
# NE PAS renseigner sauf si vos tables portent d'autres noms : les valeurs
# par défaut ci-dessous sont celles du document de production.
#   Membres · Adhesions · Inscription · Cotisation · Activite · Saisons
# GRIST_TABLE_MEMBRES=Membres
# GRIST_TABLE_ADHESIONS=Adhesions
# GRIST_TABLE_INSCRIPTIONS=Inscription
# GRIST_TABLE_COTISATIONS=Cotisation
# GRIST_TABLE_ACTIVITES=Activite
# GRIST_TABLE_SAISONS=Saisons
