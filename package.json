{
  "name": "numerik2026",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run build:cli",
    "preview": "astro preview",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "astro": "astro",
    "auth:user": "npm run -s build:cli && node dist/cli/auth-user.mjs",
    "build:cli": "esbuild scripts/auth-user.ts --bundle --platform=node --format=esm --log-level=warning \"--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=${ASTRO_OUT_DIR:-dist}/cli/auth-user.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/node": "^11.1.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/vue": "^7.0.2",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vuepic/vue-datepicker": "^14.0.0",
    "astro": "^7.2.6",
    "date-fns": "^4.4.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "mdast-util-from-markdown": "^2.1.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
