# Dépendances et sorties de build : régénérées dans l'image
node_modules
dist
.astro

# Secrets : jamais dans l'image (passés au runtime via env_file)
.env
.env.*

# Git & éditeurs
.git
.gitignore
.idea
.vscode
.DS_Store

# Logs et scratch
*.log
npm-debug.log*
scratch-*

# Comptes de l'espace bénévoles : montés en volume au runtime, jamais dans l'image
data

# Versions construites par la publication en ligne
.releases
.tmp-publication
src/content/.tmp-publication
