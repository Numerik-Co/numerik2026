# build output
/dist

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# obsidian vault settings (docs/)
.obsidian/

# Config Docker CLI locale (deploy.sh, VPS avec /root en lecture seule)
.dockercfg/

# Comptes de l'espace bénévoles (auth à plat, cf. docs/auth.md) — données, jamais versionnées
/data/

# Versions du site construites par l'espace bénévoles (publication), cf. docs/publication.md
/.releases/
/.tmp-publication/
/src/content/.tmp-publication/
/.update/
/.dockercfg/

# Contenu du site (src/content/ : pages, actualités, activités, images,
# polices, *.yaml) : propre à chaque association, jamais commité. Un nouveau
# site part du contenu de démonstration de contenu-initial/, copié par
# scripts/contenu-initial.mjs. Seul le guide des éditeurs est suivi.
/src/content/*
!/src/content/README.md
